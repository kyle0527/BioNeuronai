%% BioNeuronAI system architecture (live code, 2026-07-18)
%% Source of truth: docs/ARCHITECTURE_OVERVIEW.md
flowchart TD
    user[User / External] --> mainPy[main.py]
    user --> api[FastAPI api/app.py]
    user --> fe[frontend apps]
    mainPy --> cli[cli/main.py]
    fe --> api

    cli --> te[TradingEngine]
    cli --> ao[AutonomousOperator]
    cli --> bt[backtest service]
    cli --> news[CryptoNewsAnalyzer]
    cli --> plan[TradingPlanController]
    cli --> pre[PreTradeCheckSystem]
    api --> te
    api --> bt
    api --> news

    ws[Binance WebSocket] --> te
    te --> ss[StrategySelector]
    te --> ie[InferenceEngine shared unified_v2]
    te --> ar[ActionRecord T0 T1 T2]
    ss --> fusion[AIStrategyFusion candidates]
    fusion -.->|direction NEUTRAL only| newsAdapter[NewsAdapter]
    news --> contracts[EventContract importance]
    news --> newsAdapter
    newsAdapter --> rag[src/rag]

    ao --> plan
    ao --> pre
    ao --> adapt[AdaptationController]
    ao --> ledger[DecisionLedger]
    ao -->|execute_prepared_order| te
    ao --> ie

    ar --> mem[EpisodicMemory]
    mem --> lora[OnlineLearner LoRA]
    te --> hub[AdaptiveLearningHub]
    te --> paper[Paper connector VirtualAccount]
    te --> binance[BinanceFuturesConnector]
    cfg[config/active_model.json] --> ie
    archived[archived legacy v1 NEVER] -.->|not loaded| ie
