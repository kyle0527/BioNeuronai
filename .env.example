# BioNeuronAI 環境變數設定
# 複製此文件為 .env 並填入實際值：  cp .env.example .env
# 所有金鑰透過 os.getenv() 讀取，禁止硬編碼至程式碼

# ==============================================
# Binance API
# 測試網申請: https://testnet.binancefuture.com
# 正式網申請: https://www.binance.com
# ==============================================
BINANCE_API_KEY=
BINANCE_API_SECRET=

# true = 測試網（虛擬資金，預設）⚠️ 建議先在測試網驗證
# false = 正式網（真實資金）⚠️ 謹慎操作
BINANCE_TESTNET=true

# 正式網自動交易雙重保護。只有 live_auto 需要設為 1。
# paper_live 使用正式網行情但虛擬成交，不需要此開關。
ALLOW_LIVE_TRADING=0

# ==============================================
# 新聞資料來源
# 免費方案直接填 free，有 token 可填入以提升速率限制
# 申請: https://cryptopanic.com/developers/api/
# ==============================================
CRYPTOPANIC_API_TOKEN=free

# ==============================================
# 選填：FastAPI 伺服器設定
# ==============================================
# API_HOST=0.0.0.0
# API_PORT=8000
# FRONTEND_PORT=3000

# ==============================================
# 選填：CORS 允許來源（逗號分隔）
# 不設定時，API 只允許常見本地前端來源：
# localhost / 127.0.0.1 的 3000、8080、5173-5180。
# 正式部署請明確列出前端網址。
# ==============================================
# ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

# ==============================================
# 選填：前端 build-time API 位址
# Docker frontend 建置時會把此值寫入 Vite bundle
# ==============================================
# VITE_API_BASE_URL=http://localhost:8000

# ==============================================
# 選填：模型與訓練雲端路徑
# MODEL_PATH 可為本機 .pth 或 gs://bucket/path/model.pth
# MODEL_DIR 可為本機目錄或 gs://bucket/path，系統會尋找 {model_name}.pth
# TRAINING_OUTPUT_URI 設定後，unified_trainer 會把 output 目錄同步到 GCS
# ==============================================
# MODEL_PATH=gs://your-bucket/models/my_100m_model.pth
# MODEL_DIR=gs://your-bucket/models
# BIONEURONAI_CLOUD_CACHE=/tmp/bioneuronai_cloud
# TRAINING_OUTPUT_URI=gs://your-bucket/training-runs/run_001

# ==============================================
# 選填：GCP Secret Manager
# 建議 Cloud Run / Vertex 優先用 secret injection 注入 BINANCE_API_KEY。
# 若要讓程式直接讀 Secret Manager，才啟用以下設定。
# ==============================================
# GCP_SECRET_MANAGER_ENABLED=false
# GCP_PROJECT_ID=your-project-id
# BINANCE_API_KEY_SECRET_NAME=bioneuronai-binance-api-key
# BINANCE_API_SECRET_NAME=bioneuronai-binance-api-secret

# ==============================================
# 選填：Runtime DB 路徑
# 無狀態容器請把此路徑掛載到持久磁碟，或另行導出至雲端資料庫。
# ==============================================
# BIONEURONAI_DB_PATH=/app/data/bioneuronai/trading/runtime/trading.db

# ==============================================
# 選填：Docker bind mount 路徑
# docker-compose.yml 中的資料與日誌掛載目錄
# ==============================================
# DATA_DIR=./data
# LOGS_DIR=./logs

# ==============================================
# 選填：交易對與槓桿預設值
# （可在 config/trading_config.py 中覆寫）
# ==============================================
# SYMBOL=BTCUSDT
# LEVERAGE=10

# ==============================================
# 選填：Docker CLI 工作服務預設值
# ==============================================
# TRADE_SYMBOL=BTCUSDT
# TRADE_ACTION=long
# BACKTEST_SYMBOL=BTCUSDT
# BACKTEST_INTERVAL=1h
# BACKTEST_START=2020-01-01
# BACKTEST_END=2020-01-03
# BACKTEST_BALANCE=10000
# BACKTEST_WARMUP_BARS=10
# SIM_BALANCE=100000
# SIM_BARS=200
# SIM_START=2020-01-01
# SIM_END=2020-01-03
