{
  "_comment": "事件規則配置 - 對應 schemas.rag.EventRule。可透過 UI 面板或直接編輯此檔案調整。",
  "_schema": {
    "event_type": "事件類型識別碼（唯一）",
    "trigger_keywords": "觸發關鍵字列表（任一命中即觸發）",
    "termination_keywords": "終止關鍵字列表（Hard Stop，任一命中即解除事件）",
    "base_importance": "初始重要性，0（可忽略）~ 10（最高）；不代表固定多空",
    "minimum_importance": "有效期結束前保留的重要性下限，0 ~ base_importance",
    "duration_hours": "事件有效時間（小時）",
    "decay_mode": "重要性衰減方式：linear 或 exponential；不承載方向",
    "affected_symbols": "影響的交易對列表，null 表示影響全部"
  },
